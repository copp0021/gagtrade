-- ============================================
-- AUTO MAIL SYSTEM V4 (Mobile Responsive & Fixed Frame Error)
-- ============================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ============================================
-- 🖼️ กำหนด Asset ID รูปภาพของไอเทม (ที่ดึงมาจาก Log)
-- ============================================
local ItemIcons = {
    ["Vector"] = "rbxassetid://109912104403745",
    -- สามารถเพิ่มไอเทมอื่นๆ ต่อตรงนี้ได้ตามต้องการ:
    -- Carrot = "rbxassetid://รหัสรูปแครอท",
}

-- ============================================
-- โหลด Networking Module
-- ============================================
local Networking
local success, err = pcall(function()
    Networking = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking"))
end)

if not success then
    warn("ไม่พบ Networking Module: " .. tostring(err))
    return
end

local Mailbox = Networking.Mailbox
local isSending = false
local InventoryItems = {}
local selectedItemKey = nil
local selectedCategory = nil

-- ============================================
-- CONFIG
-- ============================================
local MAX_ITEM_PER_SEND = 9999
local MAX_SPLIT = 20
local MAX_PER_ROUND = MAX_ITEM_PER_SEND * MAX_SPLIT

-- ============================================
-- 🔥 ดึง Inventory พร้อมดึงรูปจากตาราง ItemIcons
-- ============================================
function GetMyInventory()
    local itemsMap = {}
    
    local success, PlayerStateClient = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("PlayerStateClient"))
    end)
    
    if success and PlayerStateClient then
        local LocalReplica = PlayerStateClient:GetLocalReplica()
        if LocalReplica and LocalReplica.Data and LocalReplica.Data.Inventory then
            local Inventory = LocalReplica.Data.Inventory
            
            local categories = {
                "Trowels", "Seeds", "Sprinklers", "WateringCans", 
                "Mushrooms", "Gnomes", "Raccoons", "Crates", "SeedPacks", "Props"
            }
            
            for _, catName in ipairs(categories) do
                if Inventory[catName] then
                    for name, dataVal in pairs(Inventory[catName]) do
                        local count = 0
                        if type(dataVal) == "table" then
                            count = dataVal.Count or dataVal.Amount or dataVal.Value or 1
                        else
                            count = tonumber(dataVal) or 0
                        end
                        
                        if count > 0 then
                            if not itemsMap[name] then
                                local imgUrl = ItemIcons[name] or ""
                                
                                itemsMap[name] = {
                                    Category = catName,
                                    ItemKey = name,
                                    Count = 0,
                                    DisplayName = name,
                                    Image = imgUrl
                                }
                            end
                            itemsMap[name].Count = itemsMap[name].Count + count
                        end
                    end
                end
            end
            
            -- จัดการส่วนของ Pets
            if Inventory.Pets then
                for id, data in pairs(Inventory.Pets) do
                    if data and not data.Equipped then
                        local petName = data.Name or id
                        if not itemsMap[id] then
                            itemsMap[id] = {
                                Category = "Pets",
                                ItemKey = id,
                                Count = 0,
                                DisplayName = petName,
                                PetData = data,
                                Image = ItemIcons[id] or data.Image or data.Icon or ""
                            }
                        end
                        itemsMap[id].Count = itemsMap[id].Count + 1
                    end
                end
            end
        end
    end
    
    local items = {}
    for _, itemData in pairs(itemsMap) do
        table.insert(items, itemData)
    end
    
    return items
end

function GetItemInfo(itemKey)
    for _, item in ipairs(InventoryItems) do
        if item.ItemKey == itemKey then
            return item
        end
    end
    return nil
end

-- ============================================
-- 📤 SEND LOGIC
-- ============================================
function SendBatchMail(targetUserId, items, note)
    if isSending then return false end
    if not targetUserId or targetUserId <= 0 then return false end
    if not items or #items == 0 then return false end

    isSending = true
    local batchData = {}

    for _, item in ipairs(items) do
        local count = item.Count or 1
        while count > 0 do
            local sendAmount = math.min(count, MAX_ITEM_PER_SEND)
            table.insert(batchData, {
                Category = item.Category,
                ItemKey = item.ItemKey,
                Count = sendAmount
            })
            count = count - sendAmount
        end
    end

    local success = pcall(function()
        Mailbox.SendBatch:Fire(targetUserId, batchData, note or "")
    end)

    isSending = false
    return success
end

function SendSingleMail(targetUserId, category, itemKey, count, note)
    local items = {
        {Category = category, ItemKey = itemKey, Count = count or 1}
    }
    return SendBatchMail(targetUserId, items, note)
end

function SendItemDuplex(targetUserId, category, itemKey, totalAmount, note, onProgress)
    totalAmount = math.floor(totalAmount or 0)
    if totalAmount <= 0 then return 0, 0, 0 end

    local totalRounds = math.ceil(totalAmount / MAX_PER_ROUND)
    local remaining = totalAmount
    local roundIndex = 0
    local successRounds = 0
    local failRounds = 0

    while remaining > 0 do
        roundIndex = roundIndex + 1
        local roundAmount = math.min(MAX_PER_ROUND, remaining)
        
        if onProgress then
            onProgress(roundIndex, totalRounds, roundAmount)
        end

        local ok = SendSingleMail(targetUserId, category, itemKey, roundAmount, note)
        if ok then
            successRounds = successRounds + 1
        else
            failRounds = failRounds + 1
        end

        remaining = remaining - roundAmount
        task.wait(0.15)
    end

    return successRounds, failRounds, totalRounds
end

function SendItemAuto(targetUserId, itemKey, amount, note, onProgress)
    InventoryItems = GetMyInventory()
    local itemInfo = GetItemInfo(itemKey)
    
    if not itemInfo or itemInfo.Count <= 0 then
        return { success = false, message = "ไม่พบไอเทมนี้ในกระเป๋า", sent = 0, have = 0 }
    end
    
    local category = itemInfo.Category
    local haveAmount = itemInfo.Count
    
    if not amount or amount <= 0 then amount = haveAmount end
    if amount > haveAmount then amount = haveAmount end
    
    local successRounds, failRounds, totalRounds = SendItemDuplex(
        targetUserId, category, itemKey, amount, note or "", onProgress
    )
    
    return {
        success = failRounds == 0,
        message = failRounds == 0 and "ส่งสำเร็จ!" or "ส่งไม่สมบูรณ์บางส่วน",
        sent = amount,
        have = haveAmount,
        successRounds = successRounds,
        failRounds = failRounds,
        totalRounds = totalRounds
    }
end

function SearchPlayerGlobal(username)
    if not username or username == "" then return nil end
    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(username)
    end)
    if success and userId then
        local nameSuccess, correctName = pcall(function()
            return Players:GetNameFromUserIdAsync(userId)
        end)
        return { UserId = userId, Name = nameSuccess and correctName or username }
    end
    return nil
end

