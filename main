local function PopulateInventoryList(filterText)
    for _, child in ipairs(ItemScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    InventoryItems = GetMyInventory()
    filterText = string.lower(filterText or "")
    
    local countAdded = 0
    for _, item in ipairs(InventoryItems) do
        local itemName = tostring(item.DisplayName)
        if filterText == "" or string.find(string.lower(itemName), filterText) then
            countAdded = countAdded + 1
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 42)
            btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
            btn.ZIndex = 12
            btn.AutoButtonColor = true
            btn.Text = ""
            btn.Parent = ItemScroll
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            
            local icon = Instance.new("ImageLabel")
            icon.Size = UDim2.new(0, 32, 0, 32)
            icon.Position = UDim2.new(0, 5, 0.5, -16)
            icon.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            icon.ZIndex = 13
            icon.Image = item.Image or ""
            icon.Parent = btn
            Instance.new("UICorner", icon).CornerRadius = UDim.new(0, 4)
            
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, -45, 1, 0)
            textLabel.Position = UDim2.new(0, 44, 0, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.ZIndex = 13
            textLabel.Font = Enum.Font.GothamMedium
            textLabel.Text = string.format("%s (มี: %d)", itemName, item.Count)
            textLabel.TextColor3 = Color3.fromRGB(230, 230, 255)
            textLabel.TextSize = 12
            textLabel.TextXAlignment = Enum.TextXAlignment.Left
            textLabel.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                selectedItemKey = item.ItemKey
                selectedCategory = item.Category
                SelectItemBtn.Text = string.format("✅ เลือก: %s (%d)", itemName, item.Count)
                SelectItemBtn.TextColor3 = Color3.fromRGB(100, 250, 100)
                PickerModal.Visible = false
            end)
        end
    end
    
    ItemScroll.CanvasSize = UDim2.new(0, 0, 0, countAdded * 48)
end

SelectItemBtn.MouseButton1Click:Connect(function()
    PopulateInventoryList("")
    PickerModal.Visible = true
end)

ClosePickerBtn.MouseButton1Click:Connect(function()
    PickerModal.Visible = false
end)

SearchItemBox:GetPropertyChangedSignal("Text"):Connect(function()
    PopulateInventoryList(SearchItemBox.Text)
end)

-- ============================================
-- 🖱️ SUBMIT SEND EVENT
-- ============================================
SendBtn.MouseButton1Click:Connect(function()
    if isSending then
        StatusBox.Text = "⚠️ กำลังดำเนินการส่งชุดอื่นอยู่..."
        return
    end

    local username = TargetBox.Text
    local amount = tonumber(AmountBox.Text) or 0
    local note = NoteBox.Text

    if username == "" or not selectedItemKey then
        StatusBox.Text = "❌ กรุณากรอกชื่อผู้รับและเลือกไอเทม"
        return
    end

    SendBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
    SendBtn.Text = "⏳ กำลังค้นหาข้อมูลผู้เล่น..."
    StatusBox.Text = "🔍 กำลังค้นหา UserID: " .. username

    task.spawn(function()
        local playerData = SearchPlayerGlobal(username)
        if not playerData then
            StatusBox.Text = "❌ ไม่พบผู้เล่น: " .. username
            SendBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 255)
            SendBtn.Text = "🚀 เริ่มต้นส่งไอเทม"
            return
        end

        StatusBox.Text = string.format("✅ พบผู้เล่น: %s\n📦 กำลังส่ง...", playerData.Name)

        local result = SendItemAuto(
            playerData.UserId,
            selectedItemKey,
            amount,
            note,
            function(batchIndex, totalBatches, batchAmount)
                StatusBox.Text = string.format("⏳ ส่งรอบที่ %d/%d (%d ชิ้น)", batchIndex, totalBatches, batchAmount)
            end
        )

        StatusBox.Text = string.format("✨ %s\n📦 ส่งไป: %d / มีทั้งหมด: %d\n🔄 สำเร็จ %d รอบ | ล้มเหลว %d รอบ",
            result.message, result.sent, result.have, result.successRounds, result.failRounds)
        
        SendBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 255)
        SendBtn.Text = "🚀 เริ่มต้นส่งไอเทม"
    end)
end)

-- ============================================
-- 📱 DRAGGABLE UI SUPPORT (รองรับการลากหน้าจอในมือถือ)
-- ============================================
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

print("✅ Auto Mail V4 (Fixed & Mobile Ready) โหลดสำเร็จ!")
